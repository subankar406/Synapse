---
/**
 * Hover text effect: the text changes colour on hover (of itself, or of the
 * link/button it sits directly in). No letter animation.
 * Colours: --roll-color (default: inherit) and --roll-hover-color (default: rose).
 */
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="roll">{text}</span>

<style>
  .roll {
    color: var(--roll-color, inherit);
    cursor: pointer;
    transition: color var(--dur-slow) var(--ease);
  }

  @media (hover: hover) and (min-width: 992px) {
    .roll:hover,
    :global(:is(a, button):hover) > .roll {
      color: var(--roll-hover-color, var(--color-rose));
    }
  }
</style>
