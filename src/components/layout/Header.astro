---
import { getDictionary, type Locale } from '../../i18n';
import { sections } from '../../data/site';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<header class="header" data-header>
  <div class="header__bar container">
    <Logo variant="light" height={34} alt={t.common.homeLabel} class="header__logo" />

    <nav class="header__nav" aria-label={t.nav.label}>
      {sections.map((id) => <a class="navlink" href={`#${id}`}>{t.nav.items[id]}</a>)}
    </nav>

    <div class="header__actions">
      <LangSwitch lang={lang} class="hide-mobile" />
      <Button variant="cream" size="md" modal="rdv" class="hide-mobile">{t.common.book}</Button>
      <button class="burger" type="button" aria-label={t.common.menu} aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="burger__line" aria-hidden="true"></span>
        <span class="burger__line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Drop-down menu (below 1180px): a panel under the header bar, as in the mobile design. -->
  <nav id="mobile-menu" class="menu" aria-label={t.common.menu} data-open="false" inert>
    <div class="menu__inner">
      <div class="menu__links container">
        {
          sections.map((id, i) => (
            <a class="navlink menu__link" href={`#${id}`} style={`--i: ${i}`} data-menu-close>
              {t.nav.items[id]}
            </a>
          ))
        }
        <LangSwitch lang={lang} compact />
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.dataset.open = String(open);
    menu.inert = !open;
    toggle.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(menu?.dataset.open !== 'true'));
  menu?.querySelectorAll('[data-menu-close]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('modal:open', () => setOpen(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  // Close if the viewport grows past the breakpoint while open.
  window.matchMedia('(min-width: 1181px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-burgundy);
    color: var(--color-cream);
  }

  .header :global(a:focus-visible),
  .header :global(button:focus-visible) {
    outline-color: var(--color-cream);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 16px;
  }

  .header__nav {
    display: flex;
    gap: 30px;
    font-size: var(--fs-md);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .navlink {
    color: var(--color-cream);
    text-decoration: none;
  }

  @media (hover: hover) and (min-width: 992px) {
    .navlink:hover {
      color: var(--color-white);
      text-decoration: underline;
      text-underline-offset: 6px;
    }
  }

  /* Hamburger that morphs into a cross. */
  .burger {
    position: relative;
    display: none;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(253, 241, 226, 0.5);
    background: transparent;
    color: var(--color-cream);
    cursor: pointer;
  }

  .burger__line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 2px;
    margin-left: -9px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--dur-slow) cubic-bezier(0.65, 0, 0.35, 1);
  }

  .burger__line:nth-child(1) {
    transform: translateY(-5px);
  }

  .burger__line:nth-child(2) {
    transform: translateY(3px);
  }

  .burger[aria-expanded='true'] .burger__line:nth-child(1) {
    transform: translateY(-1px) rotate(45deg);
  }

  .burger[aria-expanded='true'] .burger__line:nth-child(2) {
    transform: translateY(-1px) rotate(-45deg);
  }

  /* Drop-down menu: overlays the page just under the header bar (height animates via grid rows). */
  .menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-burgundy);
    display: none;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.65, 0, 0.35, 1),
      visibility 0.45s;
  }

  .menu[data-open='true'] {
    grid-template-rows: 1fr;
    visibility: visible;
  }

  .menu__inner {
    min-height: 0;
    overflow: hidden;
  }

  /* .container centres itself with auto margins; stretch it so content aligns left. */
  .menu__links {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-top: 8px;
    padding-bottom: 24px;
    border-top: 1px solid rgba(253, 241, 226, 0.2);
    font-size: var(--fs-menu);
    font-weight: var(--weight-bold);
  }

  .menu__link {
    padding: 12px 0;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s var(--ease),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu[data-open='true'] .menu__link {
    opacity: 1;
    transform: none;
    transition-delay: calc(120ms + var(--i) * 35ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu__link {
      transition: none;
    }
  }

  @media (max-width: 1180px) {
    .header__nav {
      display: none;
    }

    .burger {
      display: inline-block;
    }

    .menu {
      display: grid;
    }
  }
</style>
