---
import { getDictionary, type Locale } from '../../i18n';
import Button from '../ui/Button.astro';

/** Sticky "Book an appointment" bar, mobile only. */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<div class="mobile-cta">
  <Button modal="rdv" class="mobile-cta__btn">{t.common.book}</Button>
</div>

<style>
  .mobile-cta {
    display: none;
    position: sticky;
    bottom: 0;
    z-index: 30;
    padding: 12px 16px 16px;
    background: rgba(253, 241, 226, 0.96);
    border-top: 1px solid rgba(25, 0, 6, 0.08);
  }

  .mobile-cta :global(.mobile-cta__btn) {
    flex: 1;
    justify-content: center;
    padding: 16px;
  }

  @media (max-width: 767px) {
    .mobile-cta {
      display: flex;
    }
  }
</style>
