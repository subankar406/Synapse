---
import type { Locale } from '../i18n';
import { team } from '../data/team';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './layout/Header.astro';
import Footer from './layout/Footer.astro';
import Hero from './sections/Hero.astro';
import Clinic from './sections/Clinic.astro';
import Team from './sections/Team.astro';
import Expertises from './sections/Expertises.astro';
import Vision from './sections/Vision.astro';
import Pricing from './sections/Pricing.astro';
import PracticalInfo from './sections/PracticalInfo.astro';
import Faq from './sections/Faq.astro';
import CtaBand from './sections/CtaBand.astro';
import BookingModal from './modals/BookingModal.astro';
import PhysioModal from './modals/PhysioModal.astro';
import Lightbox from './ui/Lightbox.astro';
import Button from './ui/Button.astro';
import { getDictionary } from '../i18n';

/** The one-page site, composed from sections. Rendered once per locale. */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<BaseLayout lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Clinic lang={lang} />
    <Team lang={lang} />
    <Expertises lang={lang} />
    <Vision lang={lang} />
    <Pricing lang={lang} />
    <PracticalInfo lang={lang} />
    <Faq lang={lang} />
    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />

  <!-- Mobile only: booking button pinned to the bottom of the screen. -->
  <div class="mobile-cta">
    <Button modal="rdv" class="mobile-cta__btn">{t.common.book}</Button>
  </div>

  <BookingModal lang={lang} />
  {team.map((physio) => <PhysioModal lang={lang} physio={physio} />)}
  <Lightbox lang={lang} />
</BaseLayout>

<style>
  .mobile-cta {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-cta {
      position: sticky;
      bottom: 0;
      z-index: 30;
      display: flex;
      padding: 12px 16px calc(16px + env(safe-area-inset-bottom));
      background: rgba(253, 241, 226, 0.96);
      border-top: 1px solid rgba(25, 0, 6, 0.08);
    }

    .mobile-cta :global(.mobile-cta__btn) {
      flex: 1;
      justify-content: center;
      --btn-py: 16px;
      --btn-px: 16px;
      --btn-fs: var(--fs-base);
    }
  }
</style>
