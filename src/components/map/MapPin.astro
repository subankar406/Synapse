---
import type { PinPlacement } from '../../data/map';

/**
 * A positioned marker on the neighbourhood map: a bubble (slot "bubble")
 * plus a label (default slot) placed on one side of it.
 */
interface Props {
  x: number;
  y: number;
  placement: PinPlacement;
  /** Points of interest only show their label on hover/focus. */
  interactive?: boolean;
  class?: string;
}

const { x, y, placement, interactive = false, class: className } = Astro.props;
---

<span class:list={['pin', `pin--${placement}`, { 'pin--poi': interactive }, className]} style={`left: ${x}%; top: ${y}%`}>
  <slot name="bubble" />
  <span class="pin__label"><slot /></span>
</span>

<style>
  .pin {
    position: absolute;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .pin--right {
    gap: 5px;
    transform: translate(-12px, -50%);
  }

  .pin--left {
    flex-direction: row-reverse;
    gap: 5px;
    transform: translate(calc(-100% + 12px), -50%);
  }

  .pin--above {
    flex-direction: column-reverse;
    gap: 2px;
    transform: translate(-50%, calc(-100% + 12px));
  }

  .pin--below {
    flex-direction: column;
    gap: 2px;
    transform: translate(-50%, -12px);
  }

  .pin__label {
    font-size: var(--fs-2xs);
    font-weight: var(--weight-bold);
    color: var(--color-cream);
    text-shadow:
      0 0 3px var(--color-forest),
      0 0 3px var(--color-forest),
      0 0 6px var(--color-forest),
      0 0 10px var(--color-forest);
  }

  /* Points of interest: label is a cream tooltip, shown on hover / focus. */
  .pin--poi .pin__label {
    display: none;
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    background: var(--color-cream);
    color: var(--color-ink);
    text-shadow: none;
    box-shadow: var(--shadow-sm);
  }

  .pin--poi:hover,
  .pin--poi:focus-within {
    z-index: 7;
  }

  .pin--poi:hover .pin__label,
  .pin--poi:focus-within .pin__label {
    display: inline-block;
  }

  /* Touch devices can't hover: show labels once zoomed in enough. */
  @media (hover: none) {
    :global(.map[data-far='0']) .pin--poi .pin__label {
      display: inline-block;
    }
  }

  @media (max-width: 767px) {
    .pin__label {
      font-size: var(--fs-3xs);
    }
  }
</style>
