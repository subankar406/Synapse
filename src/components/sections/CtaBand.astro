---
import { getDictionary, type Locale } from '../../i18n';
import { images } from '../../data/images';
import { hasPublicFile } from '../../lib/assets';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const mark = images.markCta;
---

<Section labelledby="cta-title" tone="blush" pad="xl" innerClass="cta">
  {hasPublicFile(mark.src) && <img slot="background" class="cta__mark" src={mark.src} alt="" aria-hidden="true" />}
  <Heading id="cta-title" size="cta" parts={t.cta.title} />
  <Button modal="rdv" class="cta__btn">{t.common.book}</Button>
</Section>

<style>
  :global(.cta) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .cta__mark {
    position: absolute;
    right: 6%;
    top: 50%;
    width: 300px;
    height: auto;
    transform: translateY(-50%);
    opacity: 0.14;
    pointer-events: none;
  }

  :global(.cta__btn) {
    padding-inline: 34px;
  }
</style>
