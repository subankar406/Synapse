---
import { getDictionary, type Locale } from '../../i18n';
import { team } from '../../data/team';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Media from '../ui/Media.astro';
import Button from '../ui/Button.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<Section id="equipe" labelledby="eq-title" tone="cream">
  <Heading id="eq-title" parts={t.team.title} spacing={44} />

  <div class="team" data-stagger>
    {
      team.map((p) => (
        <article class="member">
          <div class={`member__portrait member__portrait--${p.id}`}>
            <Media
              image={p.image}
              alt={t.physio[p.id].portraitAlt}
              class="member__img"
              placeholderLabel={`${t.team.portraitPlaceholder} · ${p.firstName}`}
            />
          </div>
          <div class="member__meta">
            <div>
              <h3 class="member__name">{p.name}</h3>
              <p class="member__role">{t.team.role}</p>
            </div>
            <Button variant={p.tone} size="sm" modal={p.id} icon="plus">
              {t.common.seeMore}
            </Button>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    gap: clamp(32px, 5vw, 64px);
  }

  .member {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .member__portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 46vh;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-white);
  }

  .member__portrait :global(.member__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  .member__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .member__name {
    margin: 0;
    font-size: var(--fs-card-title);
    letter-spacing: var(--tracking-title);
  }

  .member__role {
    margin: 4px 0 0;
    font-size: var(--fs-base);
  }
</style>
