---
import { getDictionary, type Locale } from '../../i18n';
import { expertiseImages } from '../../data/content';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const items = t.expertises.items.map((copy, i) => ({ ...copy, ...expertiseImages[i] }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Section id="expertises" labelledby="exp-title" tone="forest">
  <Heading id="exp-title" parts={t.expertises.title} spacing={44} />

  <div class="carousel" data-carousel>
    <div class="carousel__track" data-track tabindex="0" role="region" aria-label={t.expertises.trackLabel}>
      {
        items.map((item) => (
          <article class="card">
            <Media image={item.image} alt={item.alt} flat={!item.photo} class="card__media" />
            <div class="card__body">
              <h3 class="card__title">{item.title}</h3>
              <p class="card__text">{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
    <button class="carousel__arrow carousel__arrow--prev" type="button" aria-label={t.expertises.prev} data-prev hidden>
      <Icon name="arrow-left" size={22} strokeWidth={2.2} />
    </button>
    <button class="carousel__arrow carousel__arrow--next" type="button" aria-label={t.expertises.next} data-next>
      <Icon name="arrow-right" size={24} strokeWidth={2.2} />
    </button>
  </div>

  <div class="progress">
    <span data-counter>01</span>
    <div class="progress__bar"><div class="progress__fill" data-fill style={`width: ${100 / items.length}%`}></div></div>
    <span class="progress__total">{pad(items.length)}</span>
  </div>
</Section>

<script>
  const GAP = 28;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const section = root.closest('section')!;
    const counter = section.querySelector<HTMLElement>('[data-counter]');
    const fill = section.querySelector<HTMLElement>('[data-fill]');
    const total = track.children.length;
    let index = 0;

    const step = () => (track.firstElementChild?.getBoundingClientRect().width ?? 0) + GAP;
    const atEnd = () => track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;

    const update = () => {
      const s = step();
      if (!s) return;
      let i = Math.round(track.scrollLeft / s);
      if (atEnd()) i = total - 1;
      if (i === index) return;
      index = i;
      if (counter) counter.textContent = String(i + 1).padStart(2, '0');
      if (fill) fill.style.width = `${((i + 1) / total) * 100}%`;
      prev.hidden = i === 0;
    };

    next.addEventListener('click', () => {
      if (atEnd()) track.scrollTo({ left: 0, behavior: 'smooth' });
      else track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
  });
</script>

<style>
  .carousel {
    position: relative;
  }

  .carousel__track {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .card {
    flex: 0 0 min(370px, 82%);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card :global(.card__media) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-right: 12px;
  }

  .card__title {
    margin: 0;
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-title);
  }

  .card__text {
    margin: 0;
    font-size: var(--fs-base);
    color: var(--color-mint);
  }

  .carousel__arrow {
    position: absolute;
    top: 138px;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .carousel__arrow[hidden] {
    display: none;
  }

  .carousel__arrow--prev {
    left: 14px;
    width: 52px;
    height: 52px;
    background: var(--color-cream);
    color: var(--color-forest);
    box-shadow: var(--shadow-float);
  }

  .carousel__arrow--next {
    right: 14px;
    width: 60px;
    height: 60px;
    background: var(--color-burgundy);
    color: var(--color-cream);
    box-shadow: var(--shadow-float-strong);
  }

  .progress {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
  }

  .progress__bar {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    background: var(--line-cream);
  }

  .progress__fill {
    height: 100%;
    background: var(--color-cream);
    transition: width var(--dur-slow) var(--ease);
  }

  .progress__total {
    color: var(--color-sage);
  }

  @media (max-width: 767px) {
    .carousel__arrow {
      top: 96px;
    }
  }
</style>
