---
import '../styles/global.css';
import { getDictionary, localeUrl, locales, type Locale } from '../i18n';
import { site } from '../data/site';
import { structuredData } from '../lib/seo';

interface Props {
  lang: Locale;
  /** Keep this page out of search results (e.g. the /v2 alternate version). */
  noindex?: boolean;
  /** Heading letters, word-by-word reveal and fade-ins (scripts/animations.ts). */
  entranceAnimations?: boolean;
}

const { lang, noindex = false, entranceAnimations = true } = Astro.props;
const t = getDictionary(lang);

const pageUrl = new URL(localeUrl(lang), Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;
const otherLocales = locales.filter((l) => l !== lang);
const jsonLd = JSON.stringify(structuredData(t, pageUrl, ogImage));
---

<!doctype html>
<html lang={lang} data-entrance={entranceAnimations ? undefined : 'off'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localeUrl(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localeUrl('en'), Astro.site)} />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={getDictionary(l).meta.ogLocale} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <!-- Structured data: clinic details + FAQ, for search and answer engines -->
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Flag animation-capable visits early so content doesn't flash before GSAP sets initial states.
      if (document.documentElement.dataset.entrance !== 'off' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('anim');
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/modals';
      import '../scripts/animations';
    </script>
  </body>
</html>
