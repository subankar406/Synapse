---
import type { TitleParts } from '../../../i18n/types';

/**
 * Section heading built from i18n `TitleParts`: plain strings plus
 * `{ text, tone }` fragments rendered in the primary/secondary colour.
 */
type Size = 'display' | 'cta' | 'vision' | 'section' | 'wide';
type Level = 'h1' | 'h2' | 'h3';

interface Props {
  parts: TitleParts;
  as?: Level;
  size?: Size;
  id?: string;
  /** Letter-stagger entrance animation (scripts/animations.ts). Default on. */
  split?: boolean;
  /** Space below the heading, in px (sections use 40–44). */
  spacing?: number;
  class?: string;
}

const { parts, as: Tag = 'h2', size = 'section', id, split = true, spacing = 0, class: className } = Astro.props;
---

<Tag id={id} class:list={['heading', `heading--${size}`, className]} style={spacing ? `--heading-spacing: ${spacing}px` : undefined} data-split={split ? '' : undefined}>
  {parts.map((part) => (typeof part === 'string' ? part : <span class={`tone-${part.tone}`}>{part.text}</span>))}
</Tag>

<style>
  .heading {
    margin: 0 0 var(--heading-spacing, 0);
    font-weight: var(--weight-bold);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }

  .heading--display {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }

  .heading--cta {
    font-size: var(--fs-cta);
    line-height: var(--lh-tight);
    max-width: 16ch;
    text-wrap: balance;
  }

  .heading--vision {
    font-size: var(--fs-h2-vision);
    line-height: var(--lh-tight);
    letter-spacing: -0.04em;
  }

  .heading--section {
    font-size: var(--fs-h2);
  }

  /* Long one-line heading that shrinks with the viewport, then wraps on mobile. */
  .heading--wide {
    font-size: var(--fs-h2-wide);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    /* h1 must stay larger than every h2 (largest mobile h2 is the CTA at ~38px). */
    .heading--display {
      font-size: 2.5rem;
      white-space: normal;
      text-wrap: balance;
    }

    .heading--wide {
      white-space: normal;
      font-size: 30px;
    }
  }
</style>
