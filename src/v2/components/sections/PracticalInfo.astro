---
import { getDictionary, type Locale } from '../../../i18n';
import { site } from '../../../data/site';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import MapEmbed from '../ui/MapEmbed.astro';
import RollText from '../ui/RollText.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<Section id="infos" labelledby="info-title" tone="white">
  <Heading id="info-title" parts={t.practical.title} spacing={40} />

  <MapEmbed lang={lang} />

  <div class="contact" data-stagger>
    <div class="contact__col contact__col--primary">
      <h3 class="contact__title">{t.practical.contactTitle}</h3>
      <a class="address-link" href={site.mapsUrl} target="_blank" rel="noopener"><RollText text={site.address.full} /></a>
      <RollText text={t.info.phone} />
      <RollText text={t.info.email} />
    </div>
    <div class="contact__col contact__col--secondary">
      <h3 class="contact__title">{t.practical.hoursTitle}</h3>
      {t.practical.hoursLines.map((line) => <span>{line}</span>)}
    </div>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: clamp(32px, 4vw, 56px);
    margin-top: 48px;
  }

  .contact__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 20px;
    border-top: 2px solid var(--accent);
    font-size: var(--fs-md);
  }

  .contact__col--primary {
    --accent: var(--color-primary);
    --roll-hover-color: var(--color-primary);
    align-items: flex-start;
  }

  .contact__col--secondary {
    --accent: var(--color-secondary);
  }

  @media (max-width: 767px) {
    .contact__col {
      font-size: 1rem;
    }
  }

  .contact__title {
    margin: 0 0 4px;
    font-size: var(--fs-sm);
    color: var(--accent);
  }
</style>
